Binaries/
/Binaries
/Plugins/Puerts/Binaries
/Releases
/Typing
/Content/Vge/Materials
/Content/Characters/Mannequins
Intermediate/
Saved/
DerivedDataCache/
Build/
*.log
*.sln
.vs/
/node_modules/
# No trailing slash on the folders the kit links from its runtime (vge/tools/runtime.mjs LINKS): git sees a junction
# as a link, not a folder, and a pattern ending in / matches folders only.
unreal/Plugins/Puerts/Binaries
unreal/Plugins/Puerts/Intermediate/
# UnrealBuildTool's build of Puerts' UBT plugin
unreal/Plugins/Puerts/Source/**/obj/
unreal/Plugins/Puerts/Source/**/bin/
# V8 binaries come from github.com/puerts/backend-v8 release V8_11.8.172__251225 (see README)
unreal/Plugins/Puerts/ThirdParty/v8_11.8.172/
# Generated by `npm run typings` (VgeGenTypings commandlet)
Typing/
# Produced by the content pipeline at dev time
unreal/Plugins/VgeLive/Content/*
!unreal/Plugins/VgeLive/Content/.keep
unreal/Plugins/VgeLive/Saved/
# Copies of the engine's glTF master materials, made by `npm run setup` (-run=VgeMaterials): engine content
unreal/Content/Vge/Materials
# Release build inputs, written and removed again by `npm run build`
unreal/Content/Vge/Imported/
unreal/Content/UI/
unreal/Content/JavaScript/vge/game.js
# Base release metadata, written by BuildCookRun -createreleaseversion
Releases/
# This machine's engine location, written by `npm run setup`
vge/config.json
# Unreal's stock Mannequin, copied from the engine's Third Person template resources (see README)
unreal/Content/Characters/Mannequins
# Plugins installed from Fab (vge/content/fab.mjs): licensed to the user. The runtime key still counts them
# (vge/tools/runtime.mjs sourceFiles). Asset packs and model files from Fab carry a .gitignore of their own.
unreal/Plugins/Marketplace/
# Junctions to agents/skills, made by agents/link-agent-skills.ts
.claude/skills
.codex/skills
/wip/
/tasks/
.code-graph/
